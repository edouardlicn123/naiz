     {
       if (mouseX < 0)
         mouseX = 0;
@@ -957,6 +953,29 @@ static void IOOUTCALL np2sysp_o0e9(UINT port, REG8 dat) {
 
 static REG8 IOINPCALL np2sysp_i0e9(UINT port) { return ((UINT8)port); }
 #endif
+/* Absolute mouse position via dedicated read-only I/O ports (P5 extension).
+ * Ports: 0x7E0=X low, 0x7E1=X high, 0x7E2=Y low, 0x7E3=Y high.
+ * Values: screen pixel coordinates (scale-independent, tracked from host). */
+static REG8 IOINPCALL np2sysp_i7e0(UINT port) {
+  int x, y;
+  mousemng_getabspos(&x, &y);
+  return (REG8)(x & 0xff);
+}
+static REG8 IOINPCALL np2sysp_i7e1(UINT port) {
+  int x, y;
+  mousemng_getabspos(&x, &y);
+  return (REG8)((x >> 8) & 0xff);
+}
+static REG8 IOINPCALL np2sysp_i7e2(UINT port) {
+  int x, y;
+  mousemng_getabspos(&x, &y);
+  return (REG8)(y & 0xff);
+}
+static REG8 IOINPCALL np2sysp_i7e3(UINT port) {
+  int x, y;
+  mousemng_getabspos(&x, &y);
+  return (REG8)((y >> 8) & 0xff);
+}
 
 // ---- I/F
 
