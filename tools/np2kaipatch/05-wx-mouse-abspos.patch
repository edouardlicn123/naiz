diff --git a/wx/np2panel.cpp b/wx/np2panel.cpp
index bddbfd9..757d403 100644
--- a/wx/np2panel.cpp
+++ b/wx/np2panel.cpp
@@ -190,16 +190,26 @@ void Np2Panel::OnMouseMove(wxMouseEvent &evt)
 	if (!m_mouseCaptured) { evt.Skip(); return; }
 
 	wxPoint pos = evt.GetPosition();
-	int cx = GetClientSize().x / 2;
-	int cy = GetClientSize().y / 2;
 	int dx = pos.x - m_lastMousePos.x;
 	int dy = pos.y - m_lastMousePos.y;
 
 	if (dx || dy) {
 		mousemng_onmove(dx, dy);
-		/* warp cursor back to center to allow unlimited movement */
-		WarpPointer(cx, cy);
-		m_lastMousePos = wxPoint(cx, cy);
+		m_lastMousePos = pos;
+
+		/* Absolute position scaled to the 640x400 emulated screen.
+		 * No WarpPointer: the host cursor tracks the emulated cursor 1:1,
+		 * so the window edge equals the emulated screen edge.  Compositors
+		 * that handle XWarpPointer non-atomically (e.g. KWin on Deepin)
+		 * re-deliver the warp as a burst of synthetic motion events with
+		 * non-zero deltas; those would be treated as real moves and drag
+		 * the cursor back toward the window center. */
+		wxSize sz = GetClientSize();
+		int sx = (sz.GetWidth()  > 0) ? pos.x * 640 / sz.GetWidth()  : pos.x;
+		int sy = (sz.GetHeight() > 0) ? pos.y * 400 / sz.GetHeight() : pos.y;
+		if (sx < 0) sx = 0; else if (sx > 639) sx = 639;
+		if (sy < 0) sy = 0; else if (sy > 399) sy = 399;
+		mousemng_setabspos(sx, sy);
 	}
 }
 
