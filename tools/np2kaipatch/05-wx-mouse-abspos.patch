+  iocore_attachinp(0x07e3, np2sysp_i7e3);
 
 #if defined(NP2APPDEV)
   iocore_attachout(0x00e9, np2sysp_o0e9);
diff --git a/wx/mousemng.cpp b/wx/mousemng.cpp
index 0a3bc01..fab9a1c 100644
--- a/wx/mousemng.cpp
+++ b/wx/mousemng.cpp
@@ -7,11 +7,30 @@ MOUSEMNG mousemng;
 
 static UINT enabled_procs = 0;
 
+/* absolute cursor position in panel coordinates (tracked for NP2 system port) */
+static int mouse_abs_x = 0;
+static int mouse_abs_y = 0;
+
 void mousemng_initialize(void)
 {
 	memset(&mousemng, 0, sizeof(mousemng));
 	mousemng.btn = uPD8255A_LEFTBIT | uPD8255A_RIGHTBIT;  /* active-low: both released */
 	mousemng.showcount = 1;
+	mouse_abs_x = 0;
+	mouse_abs_y = 0;
+}
+
+void mousemng_setabspos(int ax, int ay)
+{
+	mouse_abs_x = ax;
+	mouse_abs_y = ay;
+}
+
+UINT8 mousemng_getabspos(int *x, int *y)
+{
+	if (x) *x = mouse_abs_x;
+	if (y) *y = mouse_abs_y;
+	return 1;
 }
 
 BYTE mousemng_getstat(SINT16 *x, SINT16 *y, int clear)
