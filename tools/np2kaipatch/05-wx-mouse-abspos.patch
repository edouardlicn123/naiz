   iocore_attachout(0x07ef, np2sysp_o7ef);
   iocore_attachinp(0x07ed, np2sysp_i7ed);
   iocore_attachinp(0x07ef, np2sysp_i7ef);
+  iocore_attachinp(0x07e0, np2sysp_i7e0);
