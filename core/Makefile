# Naiz Engine — Open Watcom build
#   make                     → engine.exe + engine_a.exe（默认 DOS/4GW）
#   make engine              → engine.exe only
#   make engine-a            → engine_a.exe（AUTOEXIT，不等待键盘）
#   make EXTENDER=dos32a     → 开源 DOS/32A 路径（需盘上 DOS32A.EXE）
#   make EXTENDER=causeway   → 历史实验路径（已冻结，非交付链；见 refdoc I03 §零）

# 优先使用环境变量 $WATCOM（由 build.sh 设置）
# 此处 fallback 仅用于直接 make 调用时
WATCOM ?= $(shell which wcl386 >/dev/null 2>&1 && dirname $$(dirname $$(which wcl386)) || \
          { test -d ~/open-watcom-v2/rel/binl64 && echo ~/open-watcom-v2/rel; } || \
          { test -d ~/open-watcom-v2/rel/binl && echo ~/open-watcom-v2/rel; } || \
          { test -d /opt/watcom/binl64 && echo /opt/watcom; } || \
          { test -f /usr/binl64/wcl386 && echo /usr; } || true)
ifneq ($(WATCOM),)
export WATCOM
export PATH := $(WATCOM)/binl64:$(PATH)
export PATH := $(WATCOM)/binl:$(PATH)
# wlink 绑定 extender 时会按 PATH 搜索 dos32a.exe；缺了它只发 W1093 警告并产出
# 未绑定的 EXE（banner 后直接退出）。binw 存放该文件。
export PATH := $(WATCOM)/binw:$(PATH)
endif
ifeq ($(WATCOM),)
$(error Open Watcom not found. Run build.sh or set $$WATCOM)
endif
# Extender selection (refdoc I03): 日常开发默认 DOS/4GW（已验证可在 np21kai 运行）；
# CauseWay 已冻结（非交付链），仅保留构建开关供历史实验复现。
EXTENDER ?= dos4g
ifeq ($(EXTENDER),dos4g)
EXT_LINK = -l=dos4g
else ifeq ($(EXTENDER),dos32a)
# DOS/32A: 开源（BSD 式许可），用于可自由再分发的 HDI。
# wlink 会把 dos32a.exe 绑定进 EXE（自包含，无需盘上外部文件）；找不到时
# 只发 W1093 警告并产出未绑定 EXE（运行只打印 banner 后退出），故提前失败。
EXT_LINK = -l=dos32a
# devdoc 194: the extender name reaches plat/ so hal_irq.c can refuse the
# PM IRQ path on DOS/32A (reflection lands on the interrupted stack).
EXT_DEFS = -DNAIZ_DOS32A=1
DOS32A_EXE := $(firstword $(wildcard $(WATCOM)/binw/dos32a.exe $(WATCOM)/dos32a.exe))
ifeq ($(DOS32A_EXE),)
$(error dos32a.exe not found under $(WATCOM)/binw - refusing to link an unbound EXE)
endif
else ifeq ($(EXTENDER),causeway)
EXT_LINK = -l=causeway
# CauseWay stub gate (devdoc 178): wlink -l=causeway embeds cwstub.exe by
# searching the cwd and $PATH. A missing stub only raises warning W1093 and
# still emits a broken 5KB LE executable, so fail fast here instead.
CWSTUB := $(shell which cwstub.exe 2>/dev/null)
ifeq ($(CWSTUB),)
$(error cwstub.exe not found in cwd/PATH - install the CauseWay devkit cwstub.exe into the Watcom bin dir, or add its directory to PATH (devdoc 178))
endif
else
$(error Unknown EXTENDER '$(EXTENDER)' - use dos4g, dos32a or causeway)
endif
NAIZ_DEBUG ?= ON
# Extra compile-time defines for diagnostic builds (devdoc 150):
#   make -C core EXTRA_DEFS=-DBGM_TICK_TRACE=1
EXTRA_DEFS ?=
CC      = wcl386
TARGET  = engine.exe
BUILD   = build

# 编译隔离：每层只能看到自己的头文件和共享的 lib/。
# engine/ 需要 -Iplat 以访问 hal.h；plat/ 需要 -Iengine 以访问 cursor.h。
BASE    = -bt=dos $(EXT_LINK) -zq -os -s -DNAIZ_DEBUG=$(NAIZ_DEBUG) $(EXT_DEFS) $(EXTRA_DEFS)
ENG_CFLAGS = $(BASE) -Iengine -Ilib -Iplat -I$(WATCOM)/h
PLAT_CFLAGS = $(BASE) -Iplat -Ilib -Iengine -I$(WATCOM)/h -DHAL_BUILD_ALLOWED
LIB_CFLAGS  = $(BASE) -Ilib -I$(WATCOM)/h

# Source discovery: auto-collect *.c per layer. vram.c is an opt-in
# reference implementation (VRAM_DPMI_MAP) and must stay out of the build.
ENG_SRCS = $(wildcard engine/*.c)
PLAT_SRCS = $(filter-out plat/vram.c,$(wildcard plat/*.c))
LIB_SRCS  = $(wildcard lib/*.c)

ENG_OBJS = $(patsubst engine/%.c,build/%.o,$(ENG_SRCS))
PLAT_OBJS = $(patsubst plat/%.c,build/%.o,$(PLAT_SRCS))
LIB_OBJS  = $(patsubst lib/%.c,build/%.o,$(LIB_SRCS))
OBJS = $(ENG_OBJS) $(PLAT_OBJS) $(LIB_OBJS)

DIAG_OBJS = build/diag.o build/serial.o build/gdc.o build/video.o

all: engine engine-a

engine: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(BASE) -fe=$@ $(OBJS)

diag: diag.exe

diag.exe: $(DIAG_OBJS)
	$(CC) $(BASE) -Iengine -Ilib -Iplat -DHAL_BUILD_ALLOWED -fe=$@ $(DIAG_OBJS)

# diag.c (in tools/diag_c/) includes plat/ headers directly; needs HAL_BUILD_ALLOWED
build/diag.o: ../tools/diag_c/diag.c | build
	$(CC) $(ENG_CFLAGS) -DHAL_BUILD_ALLOWED -c -fo=$@ $<

build/%.o: engine/%.c | build
	$(CC) $(ENG_CFLAGS) -c -fo=$@ $<

build/%.o: plat/%.c | build
	$(CC) $(PLAT_CFLAGS) -c -fo=$@ $<

build/%.o: lib/%.c | build
	$(CC) $(LIB_CFLAGS) -c -fo=$@ $<

# devdoc 195 F7: mag.c must not be optimized.  -os miscompiles the MAG
# decompression loop: the same -od source decodes image 13 (640x400, 8bpp)
# cleanly while the -os build stops at code=13/code=11 with an impossible
# back-reference and loop-state values that contradict the recorded
# operands.  Both ownership paths and both extender chains share this file,
# so force -od (no optimization) here instead of changing the global flags.
build/mag.o: lib/mag.c | build
	$(CC) $(LIB_CFLAGS:-os=-od) -c -fo=$@ $<

# nb_asset_table.h is auto-generated by export_asset_table.py (called from build_game.py).
build/nb.o: engine/nb_asset_table.h
build/nb_anim.o: engine/nb_asset_table.h

build/nb_vars.o: engine/nb_var_table.h engine/nb_var_defs.h

build/a_nb_vars.o: engine/nb_var_table.h engine/nb_var_defs.h

build/save.o: engine/nb.h

# AUTOEXIT variant: no keyboard wait, exits after NB script completes
A_TARGET ?= engine_a.exe
A_ENG_OBJS = $(patsubst build/%,build/a_%,$(ENG_OBJS))
A_PLAT_OBJS = $(patsubst build/%,build/a_%,$(PLAT_OBJS))
A_LIB_OBJS  = $(patsubst build/%,build/a_%,$(LIB_OBJS))
A_OBJS = $(A_ENG_OBJS) $(A_PLAT_OBJS) $(A_LIB_OBJS)

# Layer-wide header dependencies (Open Watcom has no -MM; aggregate per layer).
# engine/ may include engine + lib headers and plat/hal.h.
# plat/ may include plat + lib headers and engine/cursor.h (mouse.c).
# lib/ only includes lib headers.
ENG_HEADERS = $(wildcard engine/*.h) $(wildcard lib/*.h) plat/hal.h
PLAT_HEADERS = $(wildcard plat/*.h) $(wildcard lib/*.h) engine/cursor.h
LIB_HEADERS  = $(wildcard lib/*.h)

$(ENG_OBJS) $(A_ENG_OBJS): $(ENG_HEADERS)
$(PLAT_OBJS) $(A_PLAT_OBJS): $(PLAT_HEADERS)
$(LIB_OBJS)  $(A_LIB_OBJS):  $(LIB_HEADERS)

build/a_%.o: engine/%.c | build
	$(CC) $(ENG_CFLAGS) -DAUTOEXIT -c -fo=$@ $<

build/a_%.o: plat/%.c | build
	$(CC) $(PLAT_CFLAGS) -DAUTOEXIT -c -fo=$@ $<

build/a_%.o: lib/%.c | build
	$(CC) $(LIB_CFLAGS) -DAUTOEXIT -c -fo=$@ $<

# devdoc 195 F7: AUTOEXIT twin of build/mag.o -- same -od requirement.
build/a_mag.o: lib/mag.c | build
	$(CC) $(LIB_CFLAGS:-os=-od) -DAUTOEXIT -c -fo=$@ $<

build/a_nb.o: engine/nb_asset_table.h

build/a_nb_vars.o: engine/nb_var_table.h

$(A_TARGET): $(A_OBJS)
	$(CC) $(BASE) -fe=$@ $(A_OBJS)

engine-a: $(A_TARGET)

# 开源包产物：DOS/32A 绑定版，供 makegame.sh + tools_open 基座使用
open:
	$(MAKE) EXTENDER=dos32a TARGET=engine32a.exe engine
	$(MAKE) EXTENDER=dos32a A_TARGET=engine_a32a.exe engine-a

build:
	mkdir -p build

clean:
	rm -rf build $(TARGET) $(A_TARGET) diag.exe

.PHONY: all clean engine engine-a open