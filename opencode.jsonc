{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "kekeai": {
      "name": "KekeToken",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.keketoken.com/v1",
        "apiKey": "{env:KEKEAI_API_KEY}"
      },
      "models": {
        "deepseekflash": {
          "modelID": "deepseek-v4.1-flash",
          "capabilities": {
            "tools": false,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768
          }
        }
      }
    }
  }
}
